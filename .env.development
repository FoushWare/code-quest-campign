# Local development environment for Code Quest
# Defaults used by tools/scripts/generate-web-runtime.mjs
# Use these to override local ports or modes when running locally.

CODE_QUEST_APP_PHASE=mock
CODE_QUEST_SERVICE_MODE=mock

# Optional overrides for service endpoints
AUTH_API=http://localhost:8081
CONTENT_API=http://localhost:8082
GAMIFICATION_API=http://localhost:8083
LEADERBOARD_API=http://localhost:8084
SPACED_REPETITION_API=http://localhost:8085
